            "description": "Partially migrated: embedded pp/fg curves are DSIS-resolved (via pressure-curves-service); waterDepth/riserLength/casingShoes are not yet. No top-level unitSystem/units block until the rest migrates."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "// riser-margin's own top-level fields (waterDepth, riserLength, casingShoes) are NOT yet",
                  "// migrated -- see plans/plugin-unit-system-plan.md, 'Shared-endpoint routing'. Only the",
                  "// embedded pp/fg curves (via pressure-curves-service internally) are DSIS-resolved, and this",
                  "// endpoint doesn't expose which system they're in yet. Don't assert a top-level unitSystem/units",
                  "// block here -- it deliberately doesn't have one today.",
                  "pm.test('edm.pp and edm.fg are present (pressure-curves migrated internally)', () => {",
                  "    pm.expect(json).to.have.nested.property('edm.pp');",
                  "    pm.expect(json).to.have.nested.property('edm.fg');",
                  "    pm.expect(json.edm.pp).to.be.an('array');",
                  "    pm.expect(json.edm.fg).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('edm.waterDepth and edm.riserLength are numeric (still metric-only, not migrated yet)', () => {",
                  "    pm.expect(json.edm).to.have.property('waterDepth').that.is.a('number');",
                  "    pm.expect(json.edm).to.have.property('riserLength').that.is.a('number');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
