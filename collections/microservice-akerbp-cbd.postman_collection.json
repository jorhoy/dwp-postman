    {
      "name": "v2 (DSIS units)",
      "description": "DSIS-catalogue-driven unit handling, migrated off the legacy depthUnit/pressureUnit/mudWeightUnit query params. See plans/plugin-unit-system-plan.md (akerbp-dwp-web-components, branch abp350-plugins-unit-conversion) for the design. More endpoints (casing-shoes, trajectory) land here as they migrate.",
      "item": [
        {
          "name": "GET Pressure Curves (v2, DSIS units)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{cbdBaseUrl}}/v2/pressure-curves/{{wellId}}/{{wellboreId}}/{{designId}}",
              "host": [
                "{{cbdBaseUrl}}"
              ],
              "path": [
                "v2",
                "pressure-curves",
                "{{wellId}}",
                "{{wellboreId}}",
                "{{designId}}"
              ]
            },
            "description": "Migrated: always resolves the caller's real DSIS unit system server-side (no unit query params accepted anymore) and states it in the response as `unitSystem` + `units`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('response states its own unit system (unitSystem.id + name)', () => {",
                  "    pm.expect(json).to.have.property('unitSystem');",
                  "    pm.expect(json.unitSystem).to.have.property('id').that.is.a('number');",
                  "    pm.expect(json.unitSystem).to.have.property('name').that.is.a('string');",
                  "});",
                  "",
                  "pm.test('units block has depth/pressure/mudWeight, each with unit + precision', () => {",
                  "    pm.expect(json).to.have.property('units');",
                  "    for (const kind of ['depth', 'pressure', 'mudWeight']) {",
                  "        pm.expect(json.units, kind).to.have.property(kind);",
                  "        pm.expect(json.units[kind]).to.have.property('unit').that.is.a('string');",
                  "        pm.expect(json.units[kind]).to.have.property('precision').that.is.a('number');",
                  "    }",
                  "});",
                  "",
                  "pm.test('curves is an array; if non-empty, values are numbers or null (not pre-formatted strings)', () => {",
                  "    pm.expect(json.curves).to.be.an('array');",
                  "    for (const curve of json.curves) {",
                  "        for (const point of curve.curveData ?? []) {",
                  "            for (const key of ['tvd', 'emw', 'pressure']) {",
                  "                pm.expect([null, undefined].includes(point[key]) || typeof point[key] === 'number', `${key} should be numeric or null`).to.be.true;",
                  "            }",
                  "        }",
                  "    }",
                  "});",
                  "",
                  "console.log('Resolved unit system:', json.unitSystem?.name, '-> units:', JSON.stringify(json.units));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "GET Riser Margin (v2, partially migrated)",
