              "mode": "raw",
              "raw": "{\n  \"stateData\": \"{\\\"version\\\":1,\\\"savedAt\\\":\\\"\\\",\\\"customLabels\\\":[],\\\"shapes\\\":[],\\\"sidetracks\\\":[],\\\"sidetrackOffsets\\\":[],\\\"tableRowEdits\\\":[],\\\"soiRowEdits\\\":[],\\\"labelOffsets\\\":[],\\\"showFormations\\\":true,\\\"selectedLabelTypes\\\":[\\\"section\\\",\\\"shoe\\\"],\\\"viewMode\\\":\\\"schematic\\\",\\\"depthExtension\\\":\\\"\\\"}\",\n  \"version\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/well-schematic-data/save/{{wellId}}/{{wellboreId}}/{{designId}}",
              "host": ["{{baseUrl}}"],
              "path": ["well-schematic-data", "save", "{{wellId}}", "{{wellboreId}}", "{{designId}}"]
            },
            "description": "Upsert the full schematic state. stateData is a JSON-stringified SchematicLocalState blob. version is the schema version number."
          },
          "response": []
        },
        {
          "name": "Delete Schematic State",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/well-schematic-data/delete/{{wellId}}/{{wellboreId}}/{{designId}}",
              "host": ["{{baseUrl}}"],
              "path": ["well-schematic-data", "delete", "{{wellId}}", "{{wellboreId}}", "{{designId}}"]
            },
            "description": "Delete the persisted schematic state for this well/wellbore/design. The plugin will reload from EDM defaults."
          },
          "response": []
        }
      ]
    },
